{
  "manifest_version": 3,
  "name": "Claude as Default Search",
  "version": "3.3",
  "description": "Address-bar searches go to Claude (Sonnet) and send automatically. Right-click selected text to search, ask or summarize. Remove the extension to undo.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "Claude",
      "keyword": "claude",
      "search_url": "https://claude.ai/new?q={searchTerms}&dupsearch=__TOKEN__",
      "favicon_url": "https://claude.ai/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/new*",
        "https://claude.ai/project/*"
      ],
      "js": [
        "autosend.js"
      ],
      "run_at": "document_start"
    }
  ]
}